#!/usr/bin/env bash
# mdm: renders .mdm (Markdown Music) files with Quarto.
# Usage: ./mdm render file.mdm [extra quarto options, e.g. --to pdf]
set -euo pipefail

cmd="${1:-}"
file="${2:-}"
if [[ "$cmd" != "render" || -z "$file" ]]; then
  echo "usage: mdm render file.mdm [quarto options]" >&2
  exit 1
fi
if [[ "$file" != *.mdm ]]; then
  echo "error: expected a .mdm file" >&2
  exit 1
fi
shift 2

base="${file%.mdm}"
tmp="${base}.qmd"
if [[ -e "$tmp" ]]; then
  echo "error: $tmp already exists; refusing to overwrite it" >&2
  exit 1
fi
# The dialect the copy is read as. The MDM editor reads CommonMark and Quarto
# reads Pandoc's Markdown, and Pandoc asks for a blank line before a heading
# and before a block quote where CommonMark asks for none: a `### Title` under
# the last line of a paragraph, or under the closing fence of a score, came out
# as a line of text with three hashes on it. Turning the two rules off costs
# nothing measurable (the Pandoc tree of example.mdm comes out identical), and
# it is the same dialect the VS Code export renders with (extension.js, READER).
#
# It goes in the header of the copy and not in a `--from`, which Quarto 1.9.37
# does not survive: it dies in its own readqmd.lua before reading the document.
# A file that names a dialect itself keeps it; only its YAML header is searched,
# so a line of prose that opens with `from:` is not mistaken for one.
# Plus the bare addresses the editor draws as links (extension.js, READER).
reader='markdown-blank_before_header-blank_before_blockquote+autolink_bare_uris'
# The header as Pandoc reads it: a `---` opener that is not followed by a
# blank line, closed by `---` or `...` (transforms.js, splitFrontMatter).
names_reader() {
  awk '
    NR == 1 && $0 !~ /^---[[:blank:]]*$/ { exit }
    NR == 2 && $0 ~ /^[[:blank:]]*$/ { exit }
    NR > 1 && /^(---|\.\.\.)[[:blank:]]*$/ { exit }
    NR > 1 && /^[[:blank:]]*from[[:blank:]]*:/ { named = 1; exit }
    END { if (named) exit 0; exit 1 }
  ' "$1"
}
has_header() {
  head -n 1 "$1" | grep -qE '^---[[:blank:]]*$' && sed -n 2p "$1" | grep -q '[^[:blank:]]'
}
# The blank line a thematic break needs under it. The MDM editor reads a line
# of dashes as a rule and nothing else; Pandoc reads it as the opening fence of
# a YAML metadata block as soon as the line under it is not blank, and the
# block runs to the next `---` and swallows what is in between. A `---` written
# straight above a ```abc fence took the score into one and the render died in
# Quarto's own reader ("Error parsing YAML metadata"). The blank line goes into
# the copy and never into the file, which is what the VS Code export does too
# (extension.js, withBreaks; the two are held to the same cases by the tests).
#
# Only an unbroken run of dashes, and only outside a fence: a spaced rule
# (`- - -`) is also how Pandoc rules the columns of a simple table, and a blank
# line inside an ABC block would end the tune. The line above is not consulted,
# since a line of dashes under a paragraph is a setext underline to both
# dialects and a blank line under it changes nothing (measured).
#
# And the blank line a list needs over it. CommonMark lets a list interrupt a
# paragraph and Pandoc does not, so example.mdm's opening line with its items
# under it came out one paragraph with the dashes written into it. It goes in
# where CommonMark starts the list: a bullet, or an item numbered 1, with
# something after the marker, up to three spaces in, under a line of text that
# is not in a list already and is not a heading. Not Pandoc's own
# `lists_without_preceding_blankline`, which lets "2026. Then" at the start of
# a wrapped line open a list. A `$$` block is stepped over as a fence is: a
# blank line in it would end the formula. The rule and its cases are
# withBreaks in extension.js.
breaks() {
  awk '
    function bare(s,   t) { t = s; sub(/^[[:blank:]]*/, "", t); return t }
    function indent(s) { return length(s) - length(bare(s)) }
    function runlen(s, c,   n) { n = 0; while (substr(s, n + 1, 1) == c) n++; return n }
    function blank(s) { return s ~ /^[[:space:]]*$/ }
    # Up to three spaces in, and spaces only: a tab is four columns.
    function shallow(s) { return indent(s) <= 3 && substr(s, 1, indent(s)) !~ /\t/ }
    function fenceline(s,   t, c) {
      t = bare(s); c = substr(t, 1, 1)
      return shallow(s) && (c == "`" || c == "~") && runlen(t, c) >= 3
    }
    function heading(s,   t) {
      t = bare(s)
      return shallow(s) && t ~ /^#+([ \t]|$)/ && runlen(t, "#") <= 6
    }
    # `* * *` and `- - -`: a thematic break, and not a list.
    function spacedbreak(s,   t, c) {
      t = bare(s); c = substr(t, 1, 1)
      if (!shallow(s) || (c != "-" && c != "*" && c != "_")) return 0
      gsub(/[ \t]/, "", t)
      return length(t) >= 3 && runlen(t, c) == length(t)
    }
    # The first item of a list that CommonMark lets interrupt a paragraph.
    function liststart(s,   t) {
      t = bare(s)
      if (!shallow(s) || spacedbreak(s)) return 0
      return t ~ /^[-*+][ \t]+[^ \t]/ || t ~ /^1[.)][ \t]+[^ \t]/
    }
    function listitem(s) { return bare(s) ~ /^([-*+]|[0-9]+[.)])([ \t]|$)/ }
    # A thematic break that is not a line of bare dashes: `***`, `___`, or a
    # spaced one; under a line of text Pandoc reads more of the paragraph.
    function otherbreak(s,   t, c) {
      t = bare(s); c = substr(t, 1, 1)
      if (!shallow(s) || (c != "*" && c != "_" && c != "-")) return 0
      if (c == "-" && t !~ /[ \t]/) return 0
      gsub(/[ \t]/, "", t)
      return length(t) >= 3 && runlen(t, c) == length(t)
    }
    # The cells of a pipe-table row: the outer pipes off, split at every pipe
    # not escaped with a backslash.
    function cells(s, arr,   t, n, i, ch, cur, esc) {
      t = bare(s); sub(/[[:blank:]]+$/, "", t)
      if (substr(t, 1, 1) == "|") t = substr(t, 2)
      if (substr(t, length(t), 1) == "|" && substr(t, length(t) - 1, 2) != "\\|") t = substr(t, 1, length(t) - 1)
      n = 0; cur = ""; esc = 0
      for (i = 1; i <= length(t); i++) {
        ch = substr(t, i, 1)
        if (ch == "|" && !esc) { arr[++n] = cur; cur = "" }
        else cur = cur ch
        esc = (ch == "\\" && !esc)
      }
      arr[++n] = cur
      return n
    }
    function delimrow(s,   d, n, k) {
      if (index(s, "-") == 0) return 0
      n = cells(s, d)
      if (index(s, "|") == 0 && n < 2) return 0
      for (k = 1; k <= n; k++) if (d[k] !~ /^[[:blank:]]*:?-+:?[[:blank:]]*$/) return 0
      return n
    }
    # The header row of a pipe table: a row with a pipe, over a delimiter row
    # of as many cells.
    function tablestart(i,   h, n) {
      if (i >= NR || index(line[i], "|") == 0) return 0
      n = delimrow(line[i + 1])
      return n > 0 && cells(line[i], h) == n
    }
    # Whether the paragraph line i ends belongs to a list item.
    function inlist(i,   j) {
      for (j = i; j > head && !blank(line[j]); j--) {
        if (listitem(line[j])) return 1
        if (heading(line[j]) || fenceline(line[j])) return 0
      }
      return 0
    }
    # Whether line i stands inside a list: the nearest line above that is
    # neither blank nor a continuation indented two or more is an item.
    function listcontext(i,   j) {
      for (j = i - 1; j > head; j--) {
        if (blank(line[j])) continue
        if (listitem(line[j])) return 1
        if (line[j] ~ /^(  |\t)/) continue
        return 0
      }
      return 0
    }
    function needsblank(i) {
      if (i - 1 <= head || blank(line[i - 1])) return 0
      if (interrupts(i)) return 1
      if (otherbreak(line[i])) return 1
      if (indent(line[i]) <= 3 && runlen(bare(line[i]), "-") >= 3 && bare(substr(bare(line[i]), runlen(bare(line[i]), "-") + 1)) == "" && inlist(i - 1)) return 1
      return tablestart(i) && !listitem(line[i - 1])
    }
    # Whether line i, a run of = or -, stands under a line of paragraph text
    # outside a list, which makes it a setext underline: Pandoc reads one
    # only at the margin (extension.js, underlines). No apostrophe in these
    # comments: the program is a single-quoted string of the shell.
    function underlines(i,   a) {
      if (i - 1 <= head) return 0
      a = line[i - 1]
      if (blank(a) || a ~ /^(    |\t)/) return 0
      if (heading(a) || fenceline(a) || listitem(a)) return 0
      if (shallow(a) && substr(bare(a), 1, 1) == ">") return 0
      if (otherbreak(a)) return 0
      if (shallow(a) && runlen(bare(a), "-") >= 3 && bare(substr(bare(a), runlen(bare(a), "-") + 1)) == "") return 0
      return !listcontext(i)
    }
    # A run of = or of - set in one to three spaces. Written without an
    # interval beside an alternation, which mawk 1.3.4 cannot compile.
    function underline(s,   t) {
      if (indent(s) < 1 || !shallow(s)) return 0
      t = bare(s); sub(/[[:blank:]]+$/, "", t)
      return t ~ /^=+$/ || t ~ /^-+$/
    }
    # The line as the copy carries it: an indented heading outside a list
    # brought to the margin, an indented setext underline too, and a `#`
    # ending a heading with no space before it escaped, so that Pandoc keeps
    # the sharp CommonMark keeps.
    function copyline(i,   s, t, n, k) {
      s = line[i]
      if (s ~ /^ {1,3}#/ && heading(s) && !listcontext(i)) s = bare(s)
      if (underline(s) && underlines(i)) s = bare(s)
      if (heading(s)) {
        t = s; sub(/[[:blank:]]+$/, "", t)
        n = 0; while (n < length(t) && substr(t, length(t) - n, 1) == "#") n++
        k = substr(t, length(t) - n, 1)
        if (n > 0 && n < length(t) && k != " " && k != "\t" && k != "\\") s = substr(t, 1, length(t) - n) "\\" substr(t, length(t) - n + 1)
      }
      return s
    }
    function interrupts(i,   j) {
      if (!liststart(line[i]) || i - 1 <= head) return 0
      if (blank(line[i - 1]) || heading(line[i - 1])) return 0
      for (j = i - 1; j > head && !blank(line[j]); j--) {
        if (listitem(line[j])) return 0
        if (heading(line[j]) || fenceline(line[j])) break
      }
      return 1
    }
    function out(s) { print s; lastblank = blank(s) }
    { line[NR] = $0 }
    END {
      # The YAML header, printed as it came: only the body has rules in it.
      head = 0
      if (NR > 1 && line[1] ~ /^---[[:blank:]]*$/ && !blank(line[2])) {
        for (i = 2; i <= NR; i++) if (line[i] ~ /^(---|\.\.\.)[[:blank:]]*$/) { head = i; break }
      }
      open = ""   # the run of ` or ~ the fence now standing was opened with
      math = 0    # inside a `$$` block
      for (i = 1; i <= NR; i++) {
        if (i <= head) { out(line[i]); continue }
        t = bare(line[i]); c = substr(t, 1, 1)
        fence = fenceline(line[i])
        if (open != "") {
          out(line[i])
          # A closing fence: the same character, no shorter, nothing after it.
          if (fence && c == substr(open, 1, 1) && runlen(t, c) >= length(open) &&
              bare(substr(t, runlen(t, c) + 1)) == "") open = ""
          continue
        }
        if (math) {
          out(line[i])
          # The first `$$` closes it, and a blank line ends it unclosed.
          if (index(line[i], "$$") > 0 || blank(line[i])) math = 0
          continue
        }
        if (needsblank(i) && !lastblank) out("")
        out(copyline(i))
        if (fence) { open = substr(t, 1, runlen(t, c)); continue }
        if (shallow(line[i]) && substr(t, 1, 2) == "$$") {
          math = (index(substr(t, 3), "$$") == 0)
          continue
        }
        if (indent(line[i]) > 3 || runlen(t, "-") < 3) continue
        if (bare(substr(t, runlen(t, "-") + 1)) != "") continue
        below = (i < NR) ? line[i + 1] : ""
        if (blank(below)) continue   # the blank line is already there
        out("")
      }
    }
  '
}

if names_reader "$file"; then
  breaks < "$file" > "$tmp"
elif has_header "$file"; then
  { head -n 1 "$file"; printf 'from: %s\n' "$reader"; tail -n +2 "$file"; } | breaks > "$tmp"
else
  { printf -- '---\nfrom: %s\n---\n\n' "$reader"; cat "$file"; } | breaks > "$tmp"
fi
trap 'rm -f "$tmp"' EXIT

# Quarto offers the document's other formats in the margin of the HTML ("Other
# Formats", one link per format the header declares). An .mdm usually declares
# both, so every HTML page grew a link to a PDF that is only on disk if a PDF
# was asked for too: `--to html` alone left it pointing at nothing. The editor
# the page is dressed as has no such column either, so it is off here.
#
# It goes on the command line and not in the filter: Quarto settles the format
# options before the filters run, so a `format-links` written from mdm.lua
# arrives too late and the block comes out all the same (measured). A document
# that wants the links keeps them by saying so itself, which is what the grep
# leaves room for; `-M` on the command line would otherwise outrank the header.
#
# Two calls rather than one with an array of extra arguments: `"${arr[@]}"` on
# an empty array is an unbound variable under `set -u` in bash 3.2, which is
# the bash macOS ships.
if grep -qE '^[[:space:]]*format-links[[:space:]]*:' "$file"; then
  quarto render "$tmp" "$@"
else
  quarto render "$tmp" -M format-links:false "$@"
fi
