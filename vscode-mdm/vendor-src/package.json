{
  "name": "mdm-vendor-src",
  "private": true,
  "description": "Builds media/vendor/cm6/cm6.bundle.js: CodeMirror 6, KaTeX and the MDM Lezer extensions in one file. The editor runtime never needs this directory; only `npm run vendor` does.",
  "type": "module",
  "scripts": {
    "vendor": "node build.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "codemirror": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@lezer/markdown": "^1.7.2",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "katex": "^0.18.4"
  }
}
